# Isolated Stage 8 measurement contour (disposable data lives under tests/tmp)
/data-stage8-test/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local tooling
.cocoindex_code/
.opencode/

# OpenChamber local config (machine-specific, like .opencode/)
.openchamber/

# Probe acceptance baseline (local corpus state artifact, regen via --baseline)
backend/scripts/probe-baseline.json
backend/scripts/probe-stage8-*.json

# Temporary pytest basetemp directories created by local verification
.pytest-run-*/
.pytest-*/
pytest-*/
backend/.pytest-*/
backend/pytest-*/
.tmp-*/
backend/.tmp-*/
data/exports/*
!data/exports/.gitkeep
.runtime-cookie-check/
.stage8-runtime-logs/

# Maintained test outputs and disposable test runtime data
tests/artifacts/
tests/tmp/
!tests/artifacts/
!tests/artifacts/stage8/
tests/artifacts/stage8/*
!tests/artifacts/stage8/stage8-manifest*.json
!tests/artifacts/stage8/glossary-stage8-benchmark*.json
# Full raw-export benchmark output is local acceptance evidence, never a fixture.
tests/artifacts/bulk-export/

# Keep the parent required by the component pytest basetemp paths below.
!tests/tmp/
tests/tmp/*
!tests/tmp/pytest-runs/
tests/tmp/pytest-runs/*
!tests/tmp/pytest-runs/.gitkeep

# Local understand-anything knowledge graph and dashboard artifacts
.understand-anything/

# Артефакты линтера и покрытия (CI генерирует их на каждом прогоне)
.ruff_cache/
backend/.coverage
backend/htmlcov/
