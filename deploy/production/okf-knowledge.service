[Unit]
Description=OKF Knowledge Service
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/okf-knowledge
# Install exactly one selected runtime file at this path: bundled.env sets
# COMPOSE_PROFILES=bundled; external.env leaves it empty.
EnvironmentFile=/opt/okf-knowledge/.env
Environment=OKF_RUNTIME_ENV_FILE=/opt/okf-knowledge/.env
ExecStart=/usr/bin/docker compose --env-file /opt/okf-knowledge/.env up -d --wait
ExecStop=/usr/bin/docker compose --env-file /opt/okf-knowledge/.env stop
TimeoutStartSec=10min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
