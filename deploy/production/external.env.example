# Copy to external.env. Customer-operated PostgreSQL and Qdrant stay outside
# this Compose project; leave COMPOSE_PROFILES empty.
OKF_RUNTIME_ENV_FILE=deploy/production/external.env
COMPOSE_PROFILES=
STORAGE_MODE=external
DATABASE_URL=postgresql+psycopg://okf:REPLACE_WITH_EXTERNAL_DB_PASSWORD@db.customer.internal:5432/okf_knowledge
QDRANT_URL=https://qdrant.customer.internal:6333
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION=okf_knowledge_base
DATA_DIR=./data
OKF_DIAGNOSTICS_DIR=/srv/okf-knowledge/diagnostics
DIAGNOSTICS_MIN_FREE_MB=2048
DIAGNOSTICS_BASELINE_ENABLED=true
DIAGNOSTICS_CAPTURE_ENABLED=true
DIAGNOSTICS_SUCCESS_LIMIT_PER_SECOND=10
DIAGNOSTICS_TRACE_LIMIT_PER_SECOND=1
DIAGNOSTICS_BUNDLE_ENABLED=true
DIAGNOSTICS_DOWNLOAD_ENABLED=true
OKF_BUILD_REVISION=unknown
ENVIRONMENT=production
AUTH_PROVIDER=keycloak_oidc
APP_SECRET_KEY=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
AUTH_SESSION_HTTPS_ONLY=true
SSO_REDIRECT_URI=https://kb.example.com/api/auth/callback
SSO_POST_LOGOUT_REDIRECT_URI=https://kb.example.com/
KEYCLOAK_URL=https://sso.example.com
KEYCLOAK_REALM=knowledge
KEYCLOAK_CLIENT_ID=okf-knowledge
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_SECRET
# Group claim as full paths: a same-named group elsewhere in the IdP tree must
# not grant a role. Production refuses to start without an explicit mode.
KEYCLOAK_GROUP_PATH_MODE=full_path
AUTH_ROLE_GROUPS={"/IDB/KB_Viewer":"viewer","/IDB/KB_Editor":"editor","/IDB/KB_Admin":"admin","/IDB/KB_Security":"security"}
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=openrouter/mistralai/mistral-nemo
EMBEDDING_PROVIDER=http
EMBEDDING_MODEL=ollama/bge-m3
EMBEDDING_API_BASE=https://embeddings.example.com
EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY

# Source assessment rollout: enable only after accepting the chosen profile.
SOURCE_ASSESSMENT_ENABLED=false
SOURCE_ASSESSMENT_DEFAULT_ENABLED=true
SOURCE_ASSESSMENT_BACKEND=llm
SOURCE_ASSESSMENT_SAMPLE_SIZE=5
SOURCE_ASSESSMENT_LLM_MODEL=
SOURCE_ASSESSMENT_LLM_BASE_URL=
SOURCE_ASSESSMENT_LLM_API_KEY=
SOURCE_ASSESSMENT_LLM_PROFILE=
SOURCE_ASSESSMENT_TIMEOUT_SECONDS=8
SOURCE_ASSESSMENT_MAX_CHARS_PER_FRAGMENT=2400
SOURCE_ASSESSMENT_MAX_TOTAL_CHARS=12000
SOURCE_ASSESSMENT_MAX_INPUT_TOKENS=8192
SOURCE_ASSESSMENT_MAX_OUTPUT_TOKENS=1024
# Current model: leave model/base/key/profile empty.
# Cheaper model, same connection: SOURCE_ASSESSMENT_LLM_MODEL=provider/model-placeholder
# Independent connection: set BASE_URL=https://assessment.example/v1 and its own API_KEY.
# Independent URL never inherits the primary key; its default profile is standard.
