{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domains",
    "nodes",
    "storage_classes",
    "quotas",
    "operator_permissions",
    "registry_ca",
    "backup",
    "model_limits",
    "implementations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storage_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "access_modes",
          "reattach_verified"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "access_modes": {
            "type": "array",
            "items": {
              "enum": [
                "ReadWriteOnce",
                "ReadWriteOncePod",
                "ReadWriteMany"
              ]
            }
          },
          "reattach_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "quotas": {
      "type": "object"
    },
    "operator_permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "registry_ca": {
      "type": "object",
      "required": [
        "registry_reference",
        "ca_reference"
      ],
      "properties": {
        "registry_reference": {
          "type": "string",
          "minLength": 1
        },
        "ca_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backup": {
      "type": "object",
      "required": [
        "destination_reference",
        "owner",
        "independent_failure_domain_verified"
      ],
      "properties": {
        "destination_reference": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "independent_failure_domain_verified": {
          "type": "boolean"
        }
      }
    },
    "model_limits": {
      "type": "object"
    },
    "implementations": {
      "type": "object",
      "required": [
        "postgres",
        "qdrant",
        "rwx",
        "s3"
      ],
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version",
            "license",
            "install_scope",
            "failure_model",
            "backup_restore_recipe",
            "maintenance_owner",
            "image_digests",
            "storage_requirements"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "install_scope": {
              "type": "string",
              "minLength": 1
            },
            "failure_model": {
              "type": "string",
              "minLength": 1
            },
            "backup_restore_recipe": {
              "type": "string",
              "minLength": 1
            },
            "maintenance_owner": {
              "type": "string",
              "minLength": 1
            },
            "image_digests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^.+@sha256:[0-9a-f]{64}$"
              }
            },
            "storage_requirements": {
              "type": "object"
            }
          }
        },
        "qdrant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version",
            "license",
            "install_scope",
            "failure_model",
            "backup_restore_recipe",
            "maintenance_owner",
            "image_digests",
            "storage_requirements"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "install_scope": {
              "type": "string",
              "minLength": 1
            },
            "failure_model": {
              "type": "string",
              "minLength": 1
            },
            "backup_restore_recipe": {
              "type": "string",
              "minLength": 1
            },
            "maintenance_owner": {
              "type": "string",
              "minLength": 1
            },
            "image_digests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^.+@sha256:[0-9a-f]{64}$"
              }
            },
            "storage_requirements": {
              "type": "object"
            }
          }
        },
        "rwx": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version",
            "license",
            "install_scope",
            "failure_model",
            "backup_restore_recipe",
            "maintenance_owner",
            "image_digests",
            "storage_requirements"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "install_scope": {
              "type": "string",
              "minLength": 1
            },
            "failure_model": {
              "type": "string",
              "minLength": 1
            },
            "backup_restore_recipe": {
              "type": "string",
              "minLength": 1
            },
            "maintenance_owner": {
              "type": "string",
              "minLength": 1
            },
            "image_digests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^.+@sha256:[0-9a-f]{64}$"
              }
            },
            "storage_requirements": {
              "type": "object"
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version",
            "license",
            "install_scope",
            "failure_model",
            "backup_restore_recipe",
            "maintenance_owner",
            "image_digests",
            "storage_requirements"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "install_scope": {
              "type": "string",
              "minLength": 1
            },
            "failure_model": {
              "type": "string",
              "minLength": 1
            },
            "backup_restore_recipe": {
              "type": "string",
              "minLength": 1
            },
            "maintenance_owner": {
              "type": "string",
              "minLength": 1
            },
            "image_digests": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^.+@sha256:[0-9a-f]{64}$"
              }
            },
            "storage_requirements": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
