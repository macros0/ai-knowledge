# ============================================================
# AI Knowledge Service - environment configuration
# Copy this file to .env and adjust values for your setup.
# ============================================================

# --- Service ---
APP_NAME=OKF Knowledge Service
API_PREFIX=/api
DATA_DIR=./data
# CORS allow-list (JSON-массив origin). Пусто по умолчанию: браузер не ходит на
# бэкенд напрямую (Next.js rewrites проксируют /api серверно), поэтому `*` не нужен.
# CORS_ALLOWED_ORIGINS=["https://kb.example.com"]

# --- Relational database (PostgreSQL / SQLite) ---
# Одна переменная DATABASE_URL на оба Postgres-режима — код их не различает:
#   локальный compose:   docker compose --profile local-postgres up
#                        DATABASE_URL=postgresql+psycopg://postgres:okf_dev_pg@postgres:5432/okf_knowledge
#   корпоративный:       DATABASE_URL=postgresql+psycopg://user:pass@host:5432/okf_knowledge
#   SQLite (zero-config, самый быстрый старт без всякой БД): оставить DATABASE_URL
#                        пустым — DATABASE_URL_DEV=sqlite:///./data/app.db
# Пароль в строке подключения и в POSTGRES_PASSWORD (для сервиса local-postgres)
# должны совпадать.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/okf_knowledge
DATABASE_URL_DEV=sqlite:///./data/app.db
# Пароль суперпользователя для compose-сервиса postgres (профиль local-postgres).
# POSTGRES_PASSWORD=okf_dev_pg

# --- Vector database (Qdrant) ---
# Одна переменная QDRANT_URL на оба режима — код приложения их не различает,
# выбор делается на уровне окружения развёртывания:
#   локальный compose:     docker compose --profile local-qdrant up
#                          QDRANT_URL=http://qdrant:6333        (внутри compose-сети)
#   корпоративный Qdrant:  QDRANT_URL=https://qdrant.corp.internal:6333
#                          QDRANT_API_KEY=...                  (если требует инфра-политика)
#   локальный бинарь:      .\scripts\start-all.ps1
#                          QDRANT_URL=http://localhost:16333
#                          (16333, НЕ 6333: порт 6333 попадает в исключённый
#                          диапазон Windows Hyper-V/WSL — netsh interface ipv4
#                          show excludedportrange)
QDRANT_URL=http://localhost:16333
# Опциональный API-ключ Qdrant. Пусто = без авторизации (локальный compose/бинарь).
# Для корпоративного Qdrant — задаётся, если того требует инфраструктурная политика.
# QDRANT_API_KEY=
QDRANT_COLLECTION=okf_knowledge_base
# Размер батча upsert (точек за один HTTP-запрос). 256 точек с 1024-мерным
# вектором ≈ 6-8 МБ — с запасом под серверный лимит Qdrant max_request_size_mb=32
# (монолитный upsert нескольких тысяч концептов даёт 400). 0 = дефолт 256.
# QDRANT_UPSERT_BATCH_SIZE=256
# Vector dimension must match the embedding model output size.
# bge-m3 = 1024, text-embedding-3-small = 1536, nomic-embed-text = 768

# --- Embeddings (универсальный шлюз LiteLLM) ---
# provider: fake | http
#   fake  - детерминированные локальные векторы (демо/тесты, без сети)
#   http  - любой провайдер через LiteLLM (ollama/..., openai/..., openrouter/...)
# Для Ollama: EMBEDDING_MODEL=ollama/bge-m3, EMBEDDING_API_BASE=http://localhost:11434 (без /v1).
# BATCH_SIZE защищает от 400 при >~330 inputs на запрос (Ollama-лимит).
EMBEDDING_PROVIDER=http
EMBEDDING_MODEL=ollama/bge-m3
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSIONS=1024

# --- LLM (for OKF generation and chat answers) ---
# Use any model id supported by LiteLLM: ollama/..., openai/..., anthropic/...
# Examples:
#   LLM_MODEL=ollama/qwen2.5:14b          + LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=openai/gpt-4o               + LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=openai/gpt-4o               + LLM_BASE_URL=http://localhost:8000/v1 (vLLM)
#   LLM_MODEL=openrouter/mistralai/mistral-nemo + LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=ollama/qwen2.5:14b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama

# --- LLM concurrency & retry ---
# Ограничение параллельных вызовов LLM:
# 1 = строгая очередь (рекомендуется для Zen Free tier и локальных моделей)
# 2-4 = легкая параллельность (для платных API с высоким RPM/TPM)
# 0 = без ограничений семафора (только ретраи)
LLM_MAX_CONCURRENCY=1

# Параллельность интерактивных запросов (чат): отдельный пул, не блокируется
# фоновой генерацией бандлов (bulk-семафор отдельный). 0 = без ограничений.
LLM_INTERACTIVE_CONCURRENCY=2

# Политика повторных попыток при 429 / 5xx / сетевых сбоях
LLM_RETRY_ATTEMPTS=5
LLM_RETRY_BACKOFF_SECONDS=2

# --- LLM streaming & timeouts ---
# Ответ читается стримом: таймаут считается по тишине между токенами, а не по
# общему времени. Это позволяет медленной, но живой генерации закончиться.
# Таймаут тишины между токенами (нет данных = сеть/провайдер умер)
LLM_STREAM_IDLE_TIMEOUT_SECONDS=60
# Общий жёсткий предел на весь вызов LLM
LLM_MAX_TOTAL_TIMEOUT_SECONDS=600

# --- LLM recovery (контур восстановления пайплайна) ---
# Долгий контур: превыше быстрых ретраев клиента, с задержкой 30->60->90с.
# При исчерпании документ уходит в paused (можно возобновить из UI).
LLM_CHUNK_RETRY_ATTEMPTS=3
LLM_CHUNK_RETRY_BACKOFF_SECONDS=30

# --- OKF generation ---
# Maximum characters of source text sent to the LLM in one call.
# Larger values work only if the model supports big context.
OKF_MAX_CHUNK_CHARS=8000
# Maximum characters of OKF concept body (overflow text is dropped).
OKF_MAX_CONCEPT_CHARS=4000
# Programmatic extraction of table-rows into concepts (bypasses LLM for tables
# where each row is a separate concept: XML fields, situations, definitions,
# reference codes). Threshold for minimum data rows to process a table
# programmatically; 0 or unset = disabled (LLM handles tables).
OKF_FIELD_TABLE_MIN_ROWS=5
# LLM classifier for table-lists: for each markdown table (>= threshold) LLM
# decides "does this table require per-row analysis" and identifies the key
# column. Generalizes to any table-list (not only XML fields). Disk cache
# (data/cache/table_classify/) reuses between documents. On LLM error — fallback
# to XML heuristic. true/false; default false (XML heuristic only).
OKF_TABLE_LLM_CLASSIFY=false

# Программная экстракция концептов из комментариев рецензентов (треды
# «вопрос → ответы»): детерминированный regex вместо нестабильного встраивания
# LLM; LLM получает заглушку. true/false; default true.
# OKF_COMMENT_CONCEPTS_ENABLED=true

# --- Chat: число концептов для ответа (top_k) ---
# Диапазон степпера «Свой вариант» и значение по умолчанию.
# Пресеты — кнопки быстрого выбора в чате.
# ВАЖНО: CHAT_TOP_K_PRESETS — JSON-массив (list[int] парсится через json.loads,
# поэтому CSV через запятую вызовет SettingsError).
CHAT_TOP_K_MIN=1
CHAT_TOP_K_MAX=30
CHAT_TOP_K_DEFAULT=10
CHAT_TOP_K_PRESETS=[5,10,20]

# --- Search: режим поиска по умолчанию ---
# Пресеты разворачиваются в наборы веток (dense/bm25):
#   dense   — только семантический
#   bm25    — только лексический (ключевые слова)
#   hybrid  — dense + bm25 (рекомендуется)
SEARCH_MODE_DEFAULT=hybrid

# --- Dual-index: индексация чанков ---
# Чанки индексируются как отдельные точки Qdrant (point_type="chunk") с полным
# сырым текстом. Это позволяет находить детали, которые LLM могла уронить при
# генерации концептов. Не требует реиндексации при вкл/выкл — query-time флаг.
SEARCH_INDEX_CHUNKS_ENABLED=true
OKF_MAX_CHUNK_INDEX_CHARS=8000

# --- Ветки поиска (query-time, не влияют на хранимые данные) ---
SEARCH_DENSE_ENABLED=true
SEARCH_BM25_ENABLED=true
SEARCH_GRAPH_EXPANSION_ENABLED=true

# --- RRF (Reciprocal Rank Fusion) ---
# Кандидатов на ветку до fusion. Замечания рецензентов (концепты-треды)
# дублируют контекст якоря в индексе — держите запас, чтобы основные
# концепты не вытеснялись из выборки Qdrant.
SEARCH_PER_BRANCH_TOP_K=40
SEARCH_RRF_K=60
SEARCH_RRF_DENSE_WEIGHT=1.0
SEARCH_RRF_BM25_WEIGHT=1.0
SEARCH_RRF_GRAPH_EXPANSION_WEIGHT=0.5
# Демоция концептов-замечаний (тег review) до fusion: эффективный ранг
# += penalty в каждой ветке — основной контент важнее в выдаче. 0 — выкл.
SEARCH_REVIEW_CONCEPT_RANK_PENALTY=10

# --- Контекст LLM (лимиты при merge/collapse) ---
CHAT_MAX_CONTEXT_CHARS=32000
CHAT_CONCEPT_MAX_CHARS=4000
CHAT_CHUNK_MAX_CHARS=6000

# --- Auth ---
# Провайдер аутентификации:
#   disabled        — всё открыто (локальная разработка, по умолчанию)
#   simulation      — демо-пользователи из AUTH_SIM_USERS (без внешнего сервиса)
#   keycloak_oidc   — Keycloak/OIDC через authlib (требует KEYCLOAK_*)
#   direct_ldap     — прямая интеграция с AD/LDAP (заглушка, не реализована)
#   custom_client   — собственная система авторизации клиента (заглушка)
# ВНИМАНИЕ: в production запрещены disabled И simulation (обе дают доступ без
# внешней проверки; simulation выдаёт демо-админа через /auth/simulate) — бэкенд
# на старте fail-fast падает с ValueError, а не молча открывается.
AUTH_PROVIDER=disabled
# Окружение развёртывания: development | production.
# В production бэкенд на старте fail-fast проверяет auth-конфигурацию:
#   - AUTH_PROVIDER не может быть disabled/simulation (нужен keycloak_oidc);
#   - APP_SECRET_KEY должен быть случайным, длиной >= 32 символов (не дефолт);
#   - AUTH_SESSION_HTTPS_ONLY=true (cookie только по HTTPS).
# Иначе приложение падает с ValueError ещё до поднятия uvicorn.
# Явно указывайте development для локального запуска — без этого docker-compose
# подставит дефолт production и заблокирует старт с dev-секретом.
ENVIRONMENT=development
APP_SECRET_KEY=dev-secret-change-me
# Время жизни signed-cookie сессии (секунды).
AUTH_SESSION_TTL_SECONDS=28800
# Cookie только по HTTPS — включать в проде, false локально (http://localhost).
AUTH_SESSION_HTTPS_ONLY=false
# Маппинг групп → роли (4 роли Этапа 1: viewer/editor/admin/security).
# Приоритет при пересечении групп: security > admin > editor > viewer.
# В проде переопределяется под корпоративные группы IDB (JSON-объект группа→роль).
AUTH_ROLE_GROUPS={"KB_Viewer":"viewer","KB_Editor":"editor","KB_Admin":"admin","KB_Security":"security"}
# Роль по умолчанию, если ни одна группа не совпала с маппингом.
# null/пусто = fail-closed (403). Для локального дева/симуляции ставьте "viewer".
AUTH_DEFAULT_ROLE=viewer
# Демо-пользователи для simulation: [{user_id, username, email, groups}]
AUTH_SIM_USERS=[
  {"user_id":"sim-user","username":"demo.user","email":"user@demo.local","groups":["KB_Viewer"]},
  {"user_id":"sim-editor","username":"demo.editor","email":"editor@demo.local","groups":["KB_Editor"]},
  {"user_id":"sim-admin","username":"demo.admin","email":"admin@demo.local","groups":["KB_Admin"]},
  {"user_id":"sim-security","username":"demo.security","email":"security@demo.local","groups":["KB_Security"]},
  {"user_id":"sim-guest","username":"demo.guest","email":"guest@demo.local","groups":[]}
]

# --- SSO (Keycloak) — активен только при AUTH_PROVIDER=keycloak_oidc ---
# В архитектуре IDP + IDB приложение разговаривает ТОЛЬКО с IDB (broker):
# KEYCLOAK_URL/REALM/CLIENT_* указывают на IDB, а не на IDP/AD напрямую.
# KEYCLOAK_URL=http://localhost:18081
# KEYCLOAK_REALM=myrealm
# KEYCLOAK_CLIENT_ID=my-app
# KEYCLOAK_CLIENT_SECRET=dev-secret
# Внешний URL callback. На локальном стенде фронтенд ходит на бэкенд через
# Next.js-прокси, поэтому Keycloak должен вернуть браузер на порт фронтенда
# (http://localhost:3000/api/auth/callback), а бэкенд видит :18000 (локальный
# host-порт, не 8000 — тот в исключённом диапазоне Windows Hyper-V/WSL).
# SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Куда Keycloak вернёт браузер после RP-Initiated Logout (корень фронтенда).
# Должен быть зарегистрирован в "Valid post logout redirect URIs" клиента Keycloak.
# SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Частичное переопределение claim-имён из userinfo → поля identity (JSON).
# Незаданные поля остаются стандартными OIDC-именами (sub/preferred_username/
# email/group). Частый случай — IDB отдаёт группы не в claim "group":
# KEYCLOAK_FIELD_MAPPING={"groups":"roles"}
# KEYCLOAK_FIELD_MAPPING={"groups":"groups","username":"name","external_id":"sub"}
# KEYCLOAK_FIELD_MAPPING=

# Форма имён групп в group-claim:
#   leaf      — берём текст после последнего "/" (KB_Viewer). Дефолт.
#   full_path — оставляем как есть (/IDB/KB_Viewer).
# Симптом для перехода на full_path: после интеграции с реальным IDB group-claim
# приходит вида "/realm/subgroup/RoleName", и несколько разных ролей схлопываются
# в один leaf после нормализации (ложные совпадения/коллизии имён).
# KEYCLOAK_GROUP_PATH_MODE=leaf

# Разделитель, если group-claim пришёл строкой, а не списком (обычно ",").
# KEYCLOAK_GROUP_SEPARATOR=,

# --- Защита от массовых операций + журнал ИБ (Этап 2а) ---
# Срок хранения записей audit_log (дни). Очистка — отдельной задачей.
# AUDIT_RETENTION_DAYS=365
# Soft-лимит числа документов на одну массовую операцию.
# BULK_DELETE_MAX_DOCS=50
# BULK_REGENERATE_MAX_DOCS=20
# Лимит массового редактирования тегов (Этап 4a); не ниже порога перегенерации.
# BULK_TAGS_MAX_DOCS=50
# Per-user лимиты массовой перегенерации (sliding window, in-memory).
# BULK_REGENERATE_MAX_OPS_PER_HOUR=3
# BULK_REGENERATE_MAX_DOCS_PER_HOUR=50
# Порог four-eyes (второй администратор) — по типу операции, достижим в пределах soft-лимита.
# APPROVAL_THRESHOLD_DOCS_DELETE=50
# APPROVAL_THRESHOLD_DOCS_REGENERATE=15
# Circuit breaker: макс. ожидающих массовых задач; при превышении новые → 503.
# JOB_QUEUE_MAX_PENDING=5
# Макс. ожидание завершения одного документа внутри массовой задачи (сек).
# JOB_DOC_TIMEOUT_SECONDS=3600
# Грубая оценка времени перегенерации одного документа (мин) для предпросмотра.
# BULK_REGENERATE_EST_MINUTES_PER_DOC=5.0

# --- Корзина / soft delete (Этап 4a.2) ---
# Единое окно хранения в корзине (дней), до истечения которого документ можно
# восстановить; после — фоновая автоочистка физически удаляет точки/файлы.
# TRASH_RETENTION_DAYS=14
# Автозапуск фоновой очистки корзины при старте сервера.
# TRASH_PURGE_ENABLED=true
# Интервал прогона фоновой очистки (секунды).
# TRASH_PURGE_INTERVAL_SECONDS=3600
