# ============================================================
# AI Knowledge Service - environment configuration
# Copy this file to .env and adjust values for your setup.
# ============================================================

# --- Service ---
APP_NAME=OKF Knowledge Service
API_PREFIX=/api
DATA_DIR=./data

# --- Vector database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=okf_knowledge_base
# Vector dimension must match the embedding model output size.
# bge-m3 = 1024, text-embedding-3-small = 1536, nomic-embed-text = 768
EMBEDDING_DIM=1024

# --- Embeddings (OpenAI-compatible endpoint) ---
# provider: fake | http
#   fake  - deterministic local vectors, no network needed (demo/testing only)
#   http  - any OpenAI-compatible /embeddings endpoint (Ollama, TEI, LM Studio, OpenAI, ...)
EMBEDDING_PROVIDER=http
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama

# --- LLM (for OKF generation and chat answers) ---
# Use any model id supported by LiteLLM: ollama/..., openai/..., anthropic/...
# Examples:
#   LLM_MODEL=ollama/qwen2.5:14b          + LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=openai/gpt-4o               + LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=openai/gpt-4o               + LLM_BASE_URL=http://localhost:8000/v1 (vLLM)
LLM_MODEL=ollama/qwen2.5:14b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama

# --- OKF generation ---
# Maximum characters of source text sent to the LLM in one call.
# Larger values work only if the model supports big context.
OKF_MAX_CHUNK_CHARS=8000
# Maximum characters of OKF concept body (overflow text is dropped).
OKF_MAX_CONCEPT_CHARS=4000
